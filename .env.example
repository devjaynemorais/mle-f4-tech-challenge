# Diretório-base do pipeline servido pela API (o nome do arquivo vem de config/config.yaml).
MODEL_ARTIFACTS_PATH=models/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000

# Prometheus/Grafana (usados pelo docker-compose.yml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# MLflow (runs por etapa do pipeline e treino)
MLFLOW_PORT=5000

# Pushgateway (métricas dos jobs em lote). Fora do compose, use http://localhost:9091;
# vazio desativa o envio. O compose define o endereço interno nos jobs.
PUSHGATEWAY_PORT=9091
PUSHGATEWAY_URL=
