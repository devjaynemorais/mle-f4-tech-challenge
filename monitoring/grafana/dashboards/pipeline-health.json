{
  "title": "Credit Pipeline — Saúde, Drift e Alertas",
  "uid": "pipeline-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "credit",
    "pipeline",
    "drift"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Etapas com falha na última execução",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(pipeline_stage_last_status == 0) or vector(0)",
          "legendFormat": "falhas",
          "instant": true
        }
      ],
      "description": "Conta etapas cujo último estado publicado foi falha.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Lotes barrados pelo contrato",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(data_batch_blocked) or vector(0)",
          "legendFormat": "bloqueados",
          "instant": true
        }
      ],
      "description": "Lotes cujo último resultado foi bloqueio por violação do contrato.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Alertas ativos",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "alertas",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Drift (PSI): estável × driftado",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(drift_share{method=\"psi\",comparison=\"stable_vs_drifted\"})",
          "legendFormat": "share",
          "instant": true
        }
      ],
      "description": "Fração de features com PSI >= limiar. Aviso a 2%, crítico a 5% (config.yaml).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Drift (PSI): referência × estável",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(drift_share{method=\"psi\",comparison=\"reference_vs_stable\"})",
          "legendFormat": "share",
          "instant": true
        }
      ],
      "description": "Comparação de sanidade: deve ficar abaixo dos limiares.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Status da última execução por etapa",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_stage_last_status",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Status",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "FALHOU",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "stage": "Etapa",
              "dataset": "Conjunto",
              "Value": "Status"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Duração da última execução (s)",
      "type": "bargauge",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_stage_duration_seconds",
          "legendFormat": "{{stage}} / {{dataset}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 8,
      "title": "Volume processado (linhas)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_rows_processed",
          "legendFormat": "{{stage}} / {{dataset}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 9,
      "title": "Tempo desde o último sucesso",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - pipeline_stage_last_success_timestamp_seconds",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 43200
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "stage": "Etapa",
              "dataset": "Conjunto",
              "Value": "Há"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "PSI por feature (top 15, estável × driftado)",
      "type": "bargauge",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, drift_feature_psi{comparison=\"stable_vs_drifted\"})",
          "legendFormat": "{{feature}}",
          "instant": true
        }
      ],
      "description": "PSI >= 0,25 indica drift severo; entre 0,10 e 0,25, moderado.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 11,
      "title": "Violações do contrato por regra (último lote)",
      "type": "table",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_contract_violations",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "stage": true,
              "__name__": true
            },
            "renameByName": {
              "rule": "Regra",
              "dataset": "Conjunto",
              "Value": "Linhas"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Alertas disparando",
      "type": "table",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "alertstate": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "method": true
            },
            "renameByName": {
              "alertname": "Alerta",
              "severity": "Severidade",
              "comparison": "Comparação",
              "dataset": "Conjunto",
              "stage": "Etapa"
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Score médio previsto por período",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_batch_score_mean",
          "legendFormat": "{{period}}",
          "instant": true
        }
      ],
      "description": "Proxy de degradação: o alvo do período driftado é sintético e não gera métrica de desempenho.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Taxa prevista como default",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_batch_positive_rate",
          "legendFormat": "{{period}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "AUC no período estável (alvo real)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "model_batch_roc_auc{period=\"stable\"}",
          "legendFormat": "AUC",
          "instant": true
        }
      ],
      "description": "Somente o período estável tem alvo real.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Modelo carregado na API",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(credit_model_loaded)",
          "legendFormat": "carregado",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value"
      }
    },
    {
      "id": 17,
      "title": "Aviso",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "O modelo é apoio à análise de crédito e exige revisão humana; não é decisão automática. Métricas de pipeline mostram o **último estado** de cada etapa (Pushgateway)."
      }
    }
  ]
}
